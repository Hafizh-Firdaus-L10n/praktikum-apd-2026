import os

# clear terminal (cls buat windows, clear buat mac/linux)
clear = "cls" if os.name == "nt" else "clear"

# data awal
# nested list user (username, password, role)
users = [
    ["admin", "admin123", "admin"],
    ["hafizh", "hafizh123", "user"],
]

# nested list barang (nama, lokasi, jumlah, kondisi)
barang = [
    ["Setrika", "Ruang Jemur", 2, "Baik"],
    ["Kulkas", "Dapur Bersama", 1, "Baik"],
    ["Mesin Cuci", "Ruang Jemur", 1, "Rusak Ringan"],
    ["Sapu", "Gudang", 5, "Baik"],
]

daftar_kondisi = ["Baik", "Rusak Ringan", "Rusak Berat"]

# program utama
while True:
    os.system(clear)
    print("=" * 45)
    print("   SISTEM INVENTARIS BARANG KOS")
    print("=" * 45)
    print("1. Login")
    print("2. Register")
    print("3. Keluar")
    menu_awal = input("Pilih menu (1-3): ").strip()

    # login
    if menu_awal == "1":
        percobaan = 0
        user_login = None

        while percobaan < 3:
            os.system(clear)
            print("=== LOGIN ===")
            username = input("Username: ").strip()
            password = input("Password: ").strip()

            for u in users:
                if u[0] == username and u[1] == password:
                    user_login = u

            if user_login is not None:
                break

            percobaan += 1
            print(f"Username atau password salah! Sisa percobaan: {3 - percobaan}")
            input("Tekan Enter untuk lanjut...")

        if user_login is None:
            print("Terlalu banyak percobaan gagal. Kembali ke menu awal.")
            input("Tekan Enter untuk lanjut...")
            continue

        # menu admin
        if user_login[2] == "admin":
            while True:
                os.system(clear)
                print("=" * 45)
                print(f"   MENU ADMIN - Halo, {user_login[0]}!")
                print("=" * 45)
                print("1. Tambah Barang (Create)")
                print("2. Lihat Daftar Barang (Read)")
                print("3. Ubah Data Barang (Update)")
                print("4. Hapus Barang (Delete)")
                print("5. Logout")
                menu_admin = input("Pilih menu (1-5): ").strip()

                # menambahkan barang (create)
                if menu_admin == "1":
                    os.system(clear)
                    print("=== TAMBAH BARANG ===")

                    while True:
                        nama = input("Nama barang      : ").strip()
                        if nama == "":
                            print("Nama barang tidak boleh kosong!")
                        else:
                            break

                    while True:
                        lokasi = input("Lokasi (mis. Kamar 3, Dapur): ").strip()
                        if lokasi == "":
                            print("Lokasi tidak boleh kosong!")
                        else:
                            break

                    while True:
                        jumlah = input("Jumlah           : ").strip()
                        if not jumlah.isdigit():
                            print("Jumlah harus berupa angka bulat positif!")
                        elif int(jumlah) < 1:
                            print("Jumlah minimal 1!")
                        else:
                            jumlah = int(jumlah)
                            break

                    print("Kondisi: 1. Baik  2. Rusak Ringan  3. Rusak Berat")
                    while True:
                        pilih_kondisi = input("Pilih kondisi (1-3): ").strip()
                        if pilih_kondisi in ["1", "2", "3"]:
                            kondisi = daftar_kondisi[int(pilih_kondisi) - 1]
                            break
                        else:
                            print("Pilihan harus 1, 2, atau 3!")

                    barang.append([nama, lokasi, jumlah, kondisi])
                    print("Barang berhasil ditambahkan!")
                    input("Tekan Enter untuk kembali...")

                # membaca daftar barang (read)
                elif menu_admin == "2":
                    os.system(clear)
                    print("=== DAFTAR BARANG KOS ===")
                    if len(barang) == 0:
                        print("Belum ada data barang.")
                    else:
                        print(
                            f"{'No':<4}{'Nama':<20}{'Lokasi':<18}{'Jml':<6}{'Kondisi':<14}"
                        )
                        print("-" * 62)
                        for i, b in enumerate(barang, start=1):
                            print(f"{i:<4}{b[0]:<20}{b[1]:<18}{b[2]:<6}{b[3]:<14}")
                    input("\nTekan Enter untuk kembali...")

                # memperbarui data barang (update)
                elif menu_admin == "3":
                    os.system(clear)
                    print("=== UBAH DATA BARANG ===")
                    if len(barang) == 0:
                        print("Belum ada data barang.")
                        input("Tekan Enter untuk kembali...")
                        continue

                    print(
                        f"{'No':<4}{'Nama':<20}{'Lokasi':<18}{'Jml':<6}{'Kondisi':<14}"
                    )
                    print("-" * 62)
                    for i, b in enumerate(barang, start=1):
                        print(f"{i:<4}{b[0]:<20}{b[1]:<18}{b[2]:<6}{b[3]:<14}")

                    nomor = input("\nPilih nomor barang yang diubah: ").strip()
                    if (
                        not nomor.isdigit()
                        or int(nomor) < 1
                        or int(nomor) > len(barang)
                    ):
                        print("Nomor barang tidak valid!")
                        input("Tekan Enter untuk kembali...")
                        continue

                    idx = int(nomor) - 1
                    print(f"\nBarang dipilih: {barang[idx][0]}")
                    print("1. Ubah nama")
                    print("2. Ubah lokasi")
                    print("3. Ubah jumlah")
                    print("4. Ubah kondisi")
                    print("5. Batal")
                    ubah = input("Pilih data yang diubah (1-5): ").strip()

                    if ubah == "1":
                        baru = input("Nama baru: ").strip()
                        if baru == "":
                            print("Nama tidak boleh kosong! Perubahan dibatalkan.")
                        else:
                            barang[idx][0] = baru
                            print("Nama berhasil diubah!")
                    elif ubah == "2":
                        baru = input("Lokasi baru: ").strip()
                        if baru == "":
                            print("Lokasi tidak boleh kosong! Perubahan dibatalkan.")
                        else:
                            barang[idx][1] = baru
                            print("Lokasi berhasil diubah!")
                    elif ubah == "3":
                        baru = input("Jumlah baru: ").strip()
                        if not baru.isdigit() or int(baru) < 1:
                            print(
                                "Jumlah harus angka bulat minimal 1! Perubahan dibatalkan."
                            )
                        else:
                            barang[idx][2] = int(baru)
                            print("Jumlah berhasil diubah!")
                    elif ubah == "4":
                        print("1. Baik  2. Rusak Ringan  3. Rusak Berat")
                        baru = input("Pilih kondisi baru (1-3): ").strip()
                        if baru in ["1", "2", "3"]:
                            barang[idx][3] = daftar_kondisi[int(baru) - 1]
                            print("Kondisi berhasil diubah!")
                        else:
                            print("Pilihan tidak valid! Perubahan dibatalkan.")
                    elif ubah == "5":
                        print("Perubahan dibatalkan.")
                    else:
                        print("Pilihan tidak valid!")
                    input("Tekan Enter untuk kembali...")

                # menghapus data barang (delete)
                elif menu_admin == "4":
                    os.system(clear)
                    print("=== HAPUS BARANG ===")
                    if len(barang) == 0:
                        print("Belum ada data barang.")
                        input("Tekan Enter untuk kembali...")
                        continue

                    print(
                        f"{'No':<4}{'Nama':<20}{'Lokasi':<18}{'Jml':<6}{'Kondisi':<14}"
                    )
                    print("-" * 62)
                    for i, b in enumerate(barang, start=1):
                        print(f"{i:<4}{b[0]:<20}{b[1]:<18}{b[2]:<6}{b[3]:<14}")

                    nomor = input("\nPilih nomor barang yang dihapus: ").strip()
                    if (
                        not nomor.isdigit()
                        or int(nomor) < 1
                        or int(nomor) > len(barang)
                    ):
                        print("Nomor barang tidak valid!")
                    else:
                        idx = int(nomor) - 1
                        yakin = (
                            input(f"Yakin hapus '{barang[idx][0]}'? (y/n): ")
                            .strip()
                            .lower()
                        )
                        if yakin == "y":
                            barang.pop(idx)
                            print("Barang berhasil dihapus!")
                        else:
                            print("Penghapusan dibatalkan.")
                    input("Tekan Enter untuk kembali...")

                # log out
                elif menu_admin == "5":
                    print("Logout berhasil.")
                    input("Tekan Enter untuk lanjut...")
                    break

                else:
                    print("Pilihan tidak valid!")
                    input("Tekan Enter untuk lanjut...")

        # menu user biasa
        else:
            while True:
                os.system(clear)
                print("=" * 45)
                print(f"   MENU PENGGUNA - Halo, {user_login[0]}!")
                print("=" * 45)
                print("1. Lihat Daftar Barang")
                print("2. Logout")
                menu_user = input("Pilih menu (1-2): ").strip()

                if menu_user == "1":
                    os.system(clear)
                    print("=== DAFTAR BARANG KOS ===")
                    if len(barang) == 0:
                        print("Belum ada data barang.")
                    else:
                        print(
                            f"{'No':<4}{'Nama':<20}{'Lokasi':<18}{'Jml':<6}{'Kondisi':<14}"
                        )
                        print("-" * 62)
                        for i, b in enumerate(barang, start=1):
                            print(f"{i:<4}{b[0]:<20}{b[1]:<18}{b[2]:<6}{b[3]:<14}")
                    input("\nTekan Enter untuk kembali...")

                elif menu_user == "2":
                    print("Logout berhasil.")
                    input("Tekan Enter untuk lanjut...")
                    break

                else:
                    print("Pilihan tidak valid!")
                    input("Tekan Enter untuk lanjut...")

    # register
    elif menu_awal == "2":
        os.system(clear)
        print("=== REGISTER ===")
        username_baru = input("Username baru: ").strip()

        sudah_ada = False
        for u in users:
            if u[0] == username_baru:
                sudah_ada = True

        if username_baru == "" or " " in username_baru:
            print("Username tidak boleh kosong atau mengandung spasi!")
        elif sudah_ada:
            print("Username sudah dipakai!")
        else:
            password_baru = input("Password baru (min. 6 karakter): ").strip()
            if len(password_baru) < 6:
                print("Password minimal 6 karakter!")
            else:
                users.append([username_baru, password_baru, "user"])
                print("Registrasi berhasil! Silakan login.")
        input("Tekan Enter untuk kembali...")

    # keluar dari program
    elif menu_awal == "3":
        print("Terima kasih, program selesai.")
        break

    else:
        print("Pilihan tidak valid!")
        input("Tekan Enter untuk lanjut...")
